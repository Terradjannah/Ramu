<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#30536B61">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="@color/buddy_divider" /><stroke android:width="1dp" android:color="@color/buddy_outline" /></shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="@color/buddy_mint" /><stroke android:width="2dp" android:color="@color/buddy_action" /></shape>
            </item>
            <item android:state_selected="true">
                <shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="@color/buddy_selection" /><stroke android:width="2dp" android:color="@color/buddy_action" /></shape>
            </item>
            <item>
                <shape android:shape="rectangle"><corners android:radius="14dp" /><solid android:color="@color/buddy_button_clay_bg" /><stroke android:width="1dp" android:color="@color/buddy_outline" /></shape>
            </item>
        </selector>
    </item>
</ripple>
