<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="40dp" android:paddingEnd="20dp" android:paddingVertical="8dp" android:gravity="end">
    <com.google.android.material.card.MaterialCardView android:layout_width="wrap_content" android:layout_height="wrap_content" app:shapeAppearanceOverlay="@style/Shape.Buddy.Message" app:cardElevation="0dp" app:cardBackgroundColor="@color/buddy_mint" app:strokeWidth="0dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <TextView android:id="@+id/tv_user_author" style="@style/Buddy.Label" android:layout_width="wrap_content" android:text="Kamu" android:textStyle="bold" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/tv_user_message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/buddy_ink" android:textSize="16sp" android:textIsSelectable="true" android:lineSpacingMultiplier="1.2" android:breakStrategy="high_quality" />
            <TextView android:id="@+id/tv_user_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/buddy_sub" android:textSize="12sp" android:layout_marginTop="10dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
