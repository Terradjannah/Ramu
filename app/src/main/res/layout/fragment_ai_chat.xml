<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/buddy_stage" android:theme="@style/ThemeOverlay.Buddy.Surface">
    <com.assistant.adi.ui.buddy.BuddyContentColumn android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layout_gravity="center_horizontal">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:paddingBottom="4dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_chat_back" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Kembali" android:tooltipText="Kembali" app:icon="@drawable/ic_arrow_back" app:iconSize="24dp" app:iconTint="@color/buddy_stage_text_selector" app:backgroundTint="@android:color/transparent" app:strokeWidth="0dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_chat_history" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Riwayat" android:tooltipText="Riwayat" app:icon="@drawable/ic_ms_history" app:iconSize="24dp" app:iconTint="@color/buddy_stage_text_selector" app:backgroundTint="@android:color/transparent" app:strokeWidth="0dp" />
            <TextView android:id="@+id/tv_session_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingHorizontal="8dp" android:text="Obrolan baru" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/buddy_stage_ink" android:maxLines="1" android:ellipsize="end" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_new_chat" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Obrolan baru" android:tooltipText="Obrolan baru" app:icon="@drawable/ic_edit" app:iconSize="24dp" app:iconTint="@color/buddy_stage_text_selector" app:backgroundTint="@android:color/transparent" app:strokeWidth="0dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_chat_settings" style="@style/Widget.Material3.Button.IconButton" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Pengaturan AI" android:tooltipText="Pengaturan AI" app:icon="@drawable/ic_ms_settings" app:iconSize="24dp" app:iconTint="@color/buddy_stage_text_selector" app:backgroundTint="@android:color/transparent" app:strokeWidth="0dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/layout_loading_model" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:paddingBottom="8dp" android:visibility="gone">
            <com.google.android.material.progressindicator.CircularProgressIndicator android:layout_width="24dp" android:layout_height="24dp" android:indeterminate="true" app:indicatorSize="20dp" app:trackThickness="2dp" app:indicatorColor="@color/buddy_stage_ink" />
            <TextView android:id="@+id/tv_loading_model_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Menyiapkan asisten…" android:textSize="13sp" android:textColor="@color/buddy_stage_sub" android:layout_marginStart="10dp" />
        </LinearLayout>
        <com.assistant.adi.ui.ai.ChatStatusScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="12dp">
                <TextView android:id="@+id/tv_chat_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:layout_marginBottom="8dp" android:background="@drawable/buddy_banner_danger" android:textColor="@color/buddy_danger" android:visibility="gone" android:textSize="14sp" android:accessibilityLiveRegion="polite" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_retry" style="@style/Widget.Buddy.StageTextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Coba jawab lagi" android:visibility="gone" app:icon="@drawable/ic_ms_refresh" />
            </LinearLayout>
        </com.assistant.adi.ui.ai.ChatStatusScrollView>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_chat" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingVertical="12dp" />
            <ScrollView android:id="@+id/layout_empty_state" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="24dp" android:paddingBottom="16dp">
                    <TextView android:id="@+id/tv_empty_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ada yang ingin kamu tanyakan?" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/buddy_stage_ink" android:accessibilityHeading="true" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mulai dari kabar HP-mu, atau cerita yang lain." android:textSize="15sp" android:textColor="@color/buddy_stage_sub" android:lineSpacingExtra="4dp" android:layout_marginTop="10dp" android:layout_marginBottom="24dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/tv_suggest_battery" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginBottom="8dp" android:text="Kenapa HP terasa panas?" android:backgroundTint="@color/buddy_stage_button" android:gravity="start|center_vertical" android:textColor="@color/buddy_stage_ink" android:textAllCaps="false" android:textSize="15sp" android:paddingHorizontal="20dp" android:paddingVertical="12dp" app:cornerRadius="16dp" app:strokeWidth="1dp" app:strokeColor="@color/buddy_stage_button_stroke" app:rippleColor="#30536B61" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/tv_suggest_cpu" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="Bagaimana agar baterai lebih awet?" android:backgroundTint="@color/buddy_stage_button" android:gravity="start|center_vertical" android:textColor="@color/buddy_stage_ink" android:textAllCaps="false" android:textSize="15sp" android:paddingHorizontal="20dp" android:paddingVertical="12dp" app:cornerRadius="16dp" app:strokeWidth="1dp" app:strokeColor="@color/buddy_stage_button_stroke" app:rippleColor="#30536B61" />
                </LinearLayout>
            </ScrollView>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_latest_message" style="@style/Widget.Buddy.StageTextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="8dp" android:text="@string/chat_latest_message" android:visibility="gone" android:backgroundTint="@color/buddy_stage_button" app:icon="@drawable/ic_ms_arrow_downward" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingTop="6dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/tv_typing_indicator" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:paddingVertical="6dp" android:textColor="@color/buddy_stage_sub" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom">
                <com.google.android.material.card.MaterialCardView android:id="@+id/card_composer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" app:cardCornerRadius="26dp" app:cardBackgroundColor="@color/buddy_tile" app:cardElevation="0dp" app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="8dp" android:paddingTop="6dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btn_model_choice" style="@style/Widget.Buddy.StageTextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:minHeight="48dp" android:maxWidth="240dp" android:maxLines="1" android:ellipsize="end" android:text="Pilih model" android:textSize="12sp" app:icon="@drawable/ic_expand_more" app:iconGravity="end" app:iconSize="16dp" />
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingHorizontal="18dp" android:paddingVertical="14dp" android:background="@null" android:hint="Tulis pesan…" android:textSize="16sp" android:textColor="@color/buddy_ink" android:textColorHint="@color/buddy_sub" android:inputType="textShortMessage|textMultiLine|textCapSentences" android:maxLines="4" android:maxLength="6000" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_send" style="@style/Widget.Material3.Button.IconButton" android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="Kirim pesan" app:icon="@drawable/ic_send" app:iconTint="@color/buddy_ink" app:backgroundTint="@color/buddy_mint" app:cornerRadius="28dp" />
            </LinearLayout>
            <TextView android:id="@+id/tv_chat_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AI bisa keliru. Cocokkan saran dengan kondisi HP-mu." android:textSize="12sp" android:gravity="center" android:layout_marginTop="8dp" android:textColor="@color/buddy_stage_sub" />
        </LinearLayout>
    </com.assistant.adi.ui.buddy.BuddyContentColumn>
</FrameLayout>
