<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/buddy_stage" android:fillViewport="true"
    android:theme="@style/ThemeOverlay.Buddy.Surface">

    <com.assistant.adi.ui.buddy.BuddyContentColumn style="@style/Buddy.Panel" android:layout_gravity="center_horizontal">
        <LinearLayout android:id="@+id/panel_rail" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

        <LinearLayout android:id="@+id/summary_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <com.google.android.material.card.MaterialCardView android:id="@+id/card_today" style="@style/Widget.Buddy.SurfaceCard" app:cardBackgroundColor="@color/buddy_sky">
                <LinearLayout style="@style/Buddy.Panel">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView style="@style/Buddy.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/internet_today" />
                        <ImageButton android:id="@+id/btn_today_info" style="@style/Widget.Buddy.IconButton" android:layout_marginStart="@dimen/buddy_space_2" android:src="@drawable/ic_ms_info" android:tint="@color/buddy_action_text_selector" android:contentDescription="@string/internet_today_info" />
                    </LinearLayout>
                    <TextView android:id="@+id/tv_today_date" style="@style/Buddy.Label" />
                    <TextView android:id="@+id/tv_today_total" style="@style/Buddy.Value" android:layout_marginTop="8dp" android:text="Membaca catatan…" />
                    <LinearLayout android:id="@+id/today_transport_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:baselineAligned="false">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_ms_wifi" android:tint="@color/buddy_ink" android:importantForAccessibility="no" />
                            <TextView android:id="@+id/tv_today_wifi" style="@style/Buddy.Label" android:layout_marginStart="8dp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_ms_signal_cellular_alt" android:tint="@color/buddy_ink" android:importantForAccessibility="no" />
                            <TextView android:id="@+id/tv_today_mobile" style="@style/Buddy.Label" android:layout_marginStart="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/tv_today_limit" style="@style/Buddy.Label" android:layout_marginTop="12dp" />
                    <LinearLayout android:id="@+id/today_reached_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_ms_warning" android:tint="@color/buddy_danger" android:importantForAccessibility="no" />
                        <TextView style="@style/Buddy.Label" android:layout_marginStart="6dp" android:text="@string/internet_limit_reached" android:textColor="@color/buddy_danger" />
                    </LinearLayout>
                    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress_today" style="@style/Widget.Buddy.LinearProgressIndicator" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_today_set_limit" style="@style/Widget.Buddy.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/internet_set_limit" app:icon="@drawable/ic_ms_settings" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_usage_access" style="@style/Widget.Buddy.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Atur akses penggunaan" android:visibility="gone" app:icon="@drawable/ic_ms_shield" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/card_monthly" style="@style/Widget.Buddy.SurfaceCard" app:cardBackgroundColor="@color/buddy_lilac">
                <LinearLayout style="@style/Buddy.Panel">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView style="@style/Buddy.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/internet_monthly" />
                        <ImageButton android:id="@+id/btn_monthly_info" style="@style/Widget.Buddy.IconButton" android:layout_marginStart="@dimen/buddy_space_2" android:src="@drawable/ic_ms_info" android:tint="@color/buddy_action_text_selector" android:contentDescription="@string/internet_monthly_info" />
                    </LinearLayout>
                    <TextView android:id="@+id/tv_cycle_range" style="@style/Buddy.Label" />
                    <TextView android:id="@+id/tv_cycle_total" style="@style/Buddy.Value" android:layout_marginTop="8dp" />
                    <LinearLayout android:id="@+id/monthly_transport_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:baselineAligned="false">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_ms_wifi" android:tint="@color/buddy_ink" android:importantForAccessibility="no" />
                            <TextView android:id="@+id/tv_cycle_wifi" style="@style/Buddy.Label" android:layout_marginStart="8dp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_ms_signal_cellular_alt" android:tint="@color/buddy_ink" android:importantForAccessibility="no" />
                            <TextView android:id="@+id/tv_cycle_mobile" style="@style/Buddy.Label" android:layout_marginStart="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/tv_cycle_limit" style="@style/Buddy.Label" android:layout_marginTop="12dp" />
                    <LinearLayout android:id="@+id/monthly_reached_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_ms_warning" android:tint="@color/buddy_danger" android:importantForAccessibility="no" />
                        <TextView style="@style/Buddy.Label" android:layout_marginStart="6dp" android:text="@string/internet_limit_reached" android:textColor="@color/buddy_danger" />
                    </LinearLayout>
                    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress_monthly" style="@style/Widget.Buddy.LinearProgressIndicator" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_monthly_set_limit" style="@style/Widget.Buddy.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/internet_set_limit" app:icon="@drawable/ic_ms_settings" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView style="@style/Buddy.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/internet_chart_title" />
                    <ImageButton android:id="@+id/btn_chart_info" style="@style/Widget.Buddy.IconButton" android:layout_marginStart="@dimen/buddy_space_2" android:src="@drawable/ic_ms_info" android:tint="@color/buddy_action_text_selector" android:contentDescription="@string/internet_chart_info" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_usage_range_start" style="@style/Widget.Buddy.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="Dari tanggal" app:icon="@drawable/ic_ms_date_range" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_usage_range_end" style="@style/Widget.Buddy.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:layout_marginStart="8dp" android:text="Sampai tanggal" app:icon="@drawable/ic_ms_date_range" />
                </LinearLayout>
                <com.github.mikephil.charting.charts.BarChart android:id="@+id/internet_usage_chart" android:layout_width="match_parent" android:layout_height="250dp" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/tv_chart_selection" style="@style/Buddy.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:background="@color/buddy_surface_muted" android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <include android:id="@+id/history_panel" layout="@layout/view_monitor_history" android:visibility="gone" />

        <LinearLayout android:id="@+id/settings_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Buddy.SurfaceCard" app:cardBackgroundColor="@color/buddy_tile">
                <LinearLayout style="@style/Buddy.Panel">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView style="@style/Buddy.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Atur penggunaan data" />
                        <ImageButton android:id="@+id/btn_settings_info" style="@style/Widget.Buddy.IconButton" android:layout_marginStart="@dimen/buddy_space_2" android:src="@drawable/ic_ms_info" android:tint="@color/buddy_action_text_selector" android:contentDescription="@string/internet_settings_info" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_open_settings" style="@style/Widget.Buddy.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/internet_settings_budget" app:icon="@drawable/ic_ms_edit" />
                    <TextView android:id="@+id/tv_settings_budget" style="@style/Buddy.Label" android:layout_marginTop="4dp" android:text="@string/internet_budget_unset" />
                    <TextView android:id="@+id/tv_settings_daily" style="@style/Buddy.Label" android:layout_marginTop="8dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_settings_dates" style="@style/Widget.Buddy.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:text="@string/internet_settings_dates" app:icon="@drawable/ic_ms_date_range" />
                    <TextView android:id="@+id/tv_settings_dates" style="@style/Buddy.Label" android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.assistant.adi.ui.buddy.BuddyContentColumn>
</androidx.core.widget.NestedScrollView>
