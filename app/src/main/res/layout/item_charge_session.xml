<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">

    <!-- Icon/Dot indicator -->
    <View
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/circle_indicator"
        android:layout_marginEnd="12dp"/>

    <!-- Time and Delta details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_session_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:15 - 11:00"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/buddy_ink"/>

        <TextView
            android:id="@+id/tv_session_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="22 Juni 2026"
            android:textSize="12sp"
            android:textColor="@color/buddy_sub"/>
    </LinearLayout>

    <!-- Percentage gain -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tv_session_gain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+70%"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/buddy_action"/>

        <TextView
            android:id="@+id/tv_session_levels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15% → 85%"
            android:textSize="12sp"
            android:textColor="@color/buddy_sub"/>
    </LinearLayout>

</LinearLayout>
