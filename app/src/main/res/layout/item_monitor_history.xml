<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/history_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:background="@drawable/buddy_history_row_background"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="16dp"
    android:paddingBottom="4dp">
    <LinearLayout android:id="@+id/history_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/history_timestamp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/buddy_sub" android:textSize="14sp" />
        <TextView android:id="@+id/history_main" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/buddy_ink" android:textSize="18sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/history_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" />
    <TextView android:id="@+id/history_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/buddy_sub" android:textSize="14sp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/buddy_hairline" />
</LinearLayout>
