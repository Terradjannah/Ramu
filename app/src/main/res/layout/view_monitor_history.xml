<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Buddy.SurfaceCard">
    <LinearLayout style="@style/Buddy.Panel" android:orientation="vertical">
        <TextView android:id="@+id/history_title" style="@style/Buddy.Title" android:text="Catatan tersimpan" />
        <TextView android:id="@+id/history_range_summary" style="@style/Buddy.Label" android:layout_marginTop="4dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/history_range" style="@style/Widget.Buddy.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:text="Rentang" app:icon="@drawable/ic_ms_date_range" />
        <com.google.android.material.button.MaterialButton android:id="@+id/history_sort" style="@style/Widget.Buddy.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Urutkan" app:icon="@drawable/ic_ms_sort" />
        <com.google.android.material.button.MaterialButton android:id="@+id/history_filter" style="@style/Widget.Buddy.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Filter" app:icon="@drawable/ic_ms_filter_list" />
        <TextView android:id="@+id/history_state" style="@style/Buddy.Label" android:layout_marginTop="8dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/history_retry" style="@style/Widget.Buddy.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Coba lagi" android:visibility="gone" app:icon="@drawable/ic_ms_refresh" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/history_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:overScrollMode="never" />
        <TextView android:id="@+id/tv_history_empty" style="@style/Buddy.Label" android:layout_marginTop="12dp" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/history_previous" style="@style/Widget.Buddy.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="Sebelumnya" app:icon="@drawable/ic_ms_chevron_left" />
            <com.google.android.material.button.MaterialButton android:id="@+id/history_next" style="@style/Widget.Buddy.Button.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:layout_marginStart="8dp" android:text="Berikutnya" app:icon="@drawable/ic_ms_chevron_right" />
        </LinearLayout>
        <TextView android:id="@+id/history_footer" style="@style/Buddy.Label" android:layout_marginTop="8dp" android:text="Periode tanpa catatan tidak dapat dipulihkan." />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
