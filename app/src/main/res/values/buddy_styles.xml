<resources><color name="buddy_launcher">#28644F</color>
    <dimen name="buddy_space">16dp</dimen>
    <dimen name="buddy_radius">20dp</dimen>
    <style name="Widget.Buddy.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/buddy_focus_ring</item>
        <item name="backgroundTint">@color/buddy_button_primary_bg</item>
        <item name="android:textColor">@color/buddy_button_primary_text</item>
        <item name="iconTint">@color/buddy_button_primary_text</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">8dp</item>
        <item name="rippleColor">#30536B61</item>
    </style>
    <style name="Widget.Buddy.Button.Secondary" parent="Widget.Buddy.Button">
        <item name="backgroundTint">@color/buddy_button_clay_bg</item>
        <item name="android:textColor">@color/buddy_ink</item>
        <item name="iconTint">@color/buddy_ink</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/buddy_focus_ring</item>
    </style>
    <style name="Widget.Buddy.Button.Selection" parent="Widget.Buddy.Button">
        <item name="backgroundTint">@color/buddy_selection</item>
        <item name="android:textColor">@color/buddy_ink</item>
        <item name="iconTint">@color/buddy_ink</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/buddy_focus_ring</item>
    </style>
    <style name="Widget.Buddy.Button.Danger" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/buddy_danger</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/buddy_focus_ring</item>
        <item name="rippleColor">#30973C4B</item>
    </style>
    <style name="Widget.Buddy.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/buddy_focus_ring</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/buddy_action_text_selector</item>
        <item name="iconTint">@color/buddy_action_text_selector</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">8dp</item>
        <item name="rippleColor">#30536B61</item>
    </style>
    <style name="Widget.Buddy.StageTextButton" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/buddy_stage_focus_ring</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/buddy_stage_text_selector</item>
        <item name="iconTint">@color/buddy_stage_text_selector</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">8dp</item>
        <item name="rippleColor">#30536B61</item>
    </style>
    <style name="Widget.Buddy.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/buddy_action</item>
        <item name="iconTint">@color/buddy_action_text_selector</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">8dp</item>
        <item name="strokeColor">@color/buddy_surface_button_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#30536B61</item>
    </style>
    <style name="Widget.Buddy.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/buddy_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/buddy_tile</item>
    </style>
    <style name="Widget.Buddy.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/buddy_input_box_stroke</item>
        <item name="boxStrokeErrorColor">@color/buddy_danger</item>
        <item name="errorTextColor">@color/buddy_danger</item>
        <item name="errorIconTint">@color/buddy_danger</item>
        <item name="hintTextColor">@color/buddy_action</item>
        <item name="android:textColorHint">@color/buddy_input_hint_color</item>
        <item name="boxCornerRadiusTopStart">@dimen/buddy_control_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/buddy_control_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/buddy_control_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/buddy_control_radius</item>
    </style>
    <style name="Widget.Buddy.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/buddy_input_text_color</item>
        <item name="android:textColorHint">@color/buddy_sub</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
    </style>
    <style name="Widget.Buddy.LinearProgressIndicator" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">8dp</item>
        <item name="trackCornerRadius">4dp</item>
        <item name="indicatorColor">@color/buddy_action</item>
        <item name="trackColor">@color/buddy_track</item>
    </style>
    <style name="Widget.Buddy.CircularProgressIndicator" parent="Widget.Material3.CircularProgressIndicator">
        <item name="trackThickness">3dp</item>
        <item name="indicatorColor">@color/buddy_action</item>
        <item name="trackColor">@color/buddy_track</item>
    </style>
    <style name="ThemeOverlay.Buddy.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/buddy_tile</item>
        <item name="colorSurfaceContainerHigh">@color/buddy_tile</item>
        <item name="colorSurfaceContainer">@color/buddy_tile</item>
        <item name="android:colorBackground">@color/buddy_tile</item>
        <item name="colorOnSurface">@color/buddy_ink</item>
        <item name="colorOnSurfaceVariant">@color/buddy_sub</item>
        <item name="android:textColorPrimary">@color/buddy_ink</item>
        <item name="android:textColorSecondary">@color/buddy_sub</item>
        <item name="colorPrimary">@color/buddy_action</item>
        <item name="colorSecondary">@color/buddy_action</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Buddy.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Buddy.DialogButton.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Buddy.DialogButton</item>
    </style>
    <style name="Widget.Buddy.DialogButton" parent="Widget.Buddy.TextButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/buddy_focus_ring</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/buddy_action</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">#30536B61</item>
    </style>
    <style name="Widget.Buddy.DialogButton.Negative" parent="Widget.Buddy.DialogButton">
        <item name="android:textColor">@color/buddy_sub</item>
    </style>
    <style name="Widget.Buddy.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/buddy_stage</item>
        <item name="titleTextColor">@color/buddy_stage_ink</item>
        <item name="navigationIconTint">@color/buddy_stage_ink</item>
        <item name="actionMenuTextColor">@color/buddy_stage_ink</item>
        <item name="toolbarNavigationButtonStyle">@style/Widget.Buddy.ToolbarNavigationButton</item>
        <item name="actionOverflowButtonStyle">@style/Widget.Buddy.ToolbarIconButton</item>
    </style>
    <style name="Widget.Buddy.ToolbarNavigationButton" parent="Widget.AppCompat.Toolbar.Button.Navigation">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/buddy_icon_button_background</item>
    </style>
    <style name="Widget.Buddy.ToolbarIconButton" parent="Widget.AppCompat.ActionButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/buddy_icon_button_background</item>
    </style>
    <style name="Widget.Buddy.IconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/buddy_icon_button_background</item>
        <item name="rippleColor">#30536B61</item>
        <item name="android:tint">@color/buddy_button_clay_text</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="ThemeOverlay.Buddy.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurface">@color/buddy_tile</item>
        <item name="colorSurfaceContainer">@color/buddy_tile</item>
        <item name="colorSurfaceContainerHigh">@color/buddy_tile</item>
        <item name="colorOnSurface">@color/buddy_ink</item>
        <item name="colorOnSurfaceVariant">@color/buddy_sub</item>
        <item name="android:textColorPrimary">@color/buddy_ink</item>
        <item name="android:textColorSecondary">@color/buddy_sub</item>
        <item name="bottomSheetStyle">@style/Widget.Buddy.BottomSheet.Modal</item>
    </style>
    <style name="Widget.Buddy.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/buddy_tile</item>
        <item name="shapeAppearance">@style/Shape.Buddy.BottomSheet</item>
    </style>
    <style name="Shape.Buddy.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/buddy_sheet_radius</item>
        <item name="cornerSizeTopRight">@dimen/buddy_sheet_radius</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="Widget.Buddy.Badge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textColor">@color/buddy_ink</item>
        <item name="android:background">@drawable/buddy_badge_default</item>
    </style>
    <style name="Widget.Buddy.Badge.Mint" parent="Widget.Buddy.Badge">
        <item name="android:background">@drawable/buddy_badge_mint</item>
    </style>
    <style name="Widget.Buddy.Badge.Peach" parent="Widget.Buddy.Badge">
        <item name="android:background">@drawable/buddy_badge_peach</item>
    </style>
    <style name="Widget.Buddy.Badge.Lilac" parent="Widget.Buddy.Badge">
        <item name="android:background">@drawable/buddy_badge_lilac</item>
    </style>
    <style name="Widget.Buddy.Badge.Sky" parent="Widget.Buddy.Badge">
        <item name="android:background">@drawable/buddy_badge_sky</item>
    </style>
    <style name="Widget.Buddy.Badge.Danger" parent="Widget.Buddy.Badge">
        <item name="android:textColor">@color/buddy_danger</item>
        <item name="android:background">@drawable/buddy_badge_danger</item>
    </style>
    <style name="Shape.Buddy.Message" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
        <item name="cornerSizeBottomRight">6dp</item>
    </style>
    <style name="Shape.Buddy.Reply" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
        <item name="cornerSizeBottomLeft">6dp</item>
    </style>
</resources>

