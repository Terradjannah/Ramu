{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:buddy:catalog:generation:v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "familyId", "generationId", "name", "status", "models"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "familyId": {"$ref": "#/$defs/id"},
    "generationId": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "status": {"enum": ["available", "unavailable"]},
    "models": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/model"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["modelId", "familyId", "generationId", "name", "description", "status", "variants"],
      "properties": {
        "modelId": {"$ref": "#/$defs/id"},
        "familyId": {"$ref": "#/$defs/id"},
        "generationId": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "description": {"type": "string", "minLength": 1, "maxLength": 500},
        "status": {"enum": ["available", "unavailable"]},
        "variants": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/variant"}}
      }
    },
    "variant": {
      "type": "object", "additionalProperties": false,
      "required": ["variantId", "artifactVersion", "format", "runtime", "testedBackends", "minApi", "abis", "minRamBytes", "recommendedRamBytes", "minStorageBytes", "hardware", "repoId", "revision", "path", "sizeBytes", "sha256", "evidence"],
      "properties": {
        "variantId": {"$ref": "#/$defs/id"},
        "artifactVersion": {"type": "integer", "minimum": 1},
        "format": {"const": "litertlm"},
        "runtime": {"type": "object", "additionalProperties": false, "required": ["minVersion", "maxVersion"], "properties": {"minVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 24}, "maxVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 24}}},
        "testedBackends": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["cpu", "gpu", "npu"]}},
        "minApi": {"type": "integer", "minimum": 29, "maximum": 100},
        "abis": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["arm64-v8a", "armeabi-v7a", "x86_64", "x86"]}},
        "minRamBytes": {"type": "integer", "minimum": 1},
        "recommendedRamBytes": {"type": "integer", "minimum": 1},
        "minStorageBytes": {"type": "integer", "minimum": 1},
        "hardware": {"type": "object", "additionalProperties": false, "required": ["socIds", "driverIds"], "properties": {"socIds": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "driverIds": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
        "repoId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$", "maxLength": 128},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.litertlm$", "maxLength": 200},
        "sizeBytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "evidence": {"type": "object", "additionalProperties": false, "required": ["artifactSha256Verified", "artifactSource", "license", "gated", "runtimeTest", "backendTests"], "properties": {"artifactSha256Verified": {"const": true}, "artifactSource": {"type": "string", "minLength": 1, "maxLength": 300}, "license": {"type": "string", "minLength": 1, "maxLength": 100}, "gated": {"type": "boolean"}, "runtimeTest": {"type": "string", "minLength": 1, "maxLength": 300}, "backendTests": {"type": "object", "minProperties": 1, "maxProperties": 3, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 300}, "propertyNames": {"enum": ["cpu", "gpu", "npu"]}}}}
      }
    }
  }
}
